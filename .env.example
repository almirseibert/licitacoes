# ---- API ----
PORTA=4000
NODE_ENV=development
# Endereço público do painel. Entra nos links do e-mail e do WhatsApp de
# alerta; vazio, o aviso sai só com o texto.
URL_PUBLICA=https://licitacoes.studiomythos.com.br

# ---- Banco do painel de licitações (banco PRÓPRIO, separado do CRM) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=licitacoes

# ---- Login (Fase 15 — multiempresa; seção 1 do PLANO_SAAS_CONLICITACAO.md) ----
# O painel não lê mais a tabela `usuarios` do CRM: tem login e organizações
# próprios, em `licitacoes.usuarios` e `licitacoes.organizacoes`.
JWT_SECRET=
JWT_EXPIRA=8h
# Primeiro login, criado pelo `npm run semear` SE ainda não existir nenhum
# usuário. Sem os dois, o seed avisa e não cria ninguém — cadastre pela tela
# (/api/auth/cadastro) ou preencha e rode o seed de novo. Depois do primeiro
# usuário, estas duas variáveis não fazem mais nada: a senha vira da pessoa.
ADMIN_EMAIL_PADRAO=
ADMIN_SENHA_PADRAO=

# ---- Fila ----
# mysql (padrão) | bullmq
FILA_DRIVER=mysql
FILA_INTERVALO_MS=30000
REDIS_URL=

# ---- Arquivos ----
DIR_DADOS=/dados
# Teto de download por licitação (seção 7.2, item 6). A tela de
# Configurações pode apertar ou folgar isto sem deploy.
LIMITE_MB_POR_LICITACAO=300

# ---- Coleta ----
USER_AGENT=StudioMythosLicitacoes/1.0 (+https://studiomythos.com.br)
HTTP_TIMEOUT_MS=30000
HTTP_CONCORRENCIA=4
HTTP_INTERVALO_DOMINIO_MS=1500

# ---- Leitura assistida por IA (seção 23; opcional) ----
# Sem a chave, a IA fica desligada e o painel funciona inteiro sem ela.
GEMINI_API_KEY=
IA_MODELO=gemini-2.5-flash
IA_TIMEOUT_MS=90000
IA_MAX_TOKENS_SAIDA=4096
IA_ORCAMENTO_RACIOCINIO=512
IA_PONTUACAO_MINIMA=55
# Desliga a IA sem apagar a chave — para cortar gasto por uns dias.
IA_ATIVA=true
# Teto de texto do edital enviado ao modelo (seção 23.3).
IA_MAX_CARACTERES=60000
# Preço por milhão de tokens, em reais, só para o livro-caixa de `ia_execucoes`.
IA_PRECO_ENTRADA=
IA_PRECO_SAIDA=

# ---- Sanções CEIS/CNEP (seção 26.3; opcional) ----
# Chave gratuita do Portal da Transparência, pelo cadastro no gov.br.
# Sem ela a consulta de sanções fica desligada.
PORTAL_TRANSPARENCIA_CHAVE=

# ---- Feriados nacionais (seção 25.1) ----
# Em variável para o dia em que a BrasilAPI mudar de endereço, ou para
# apontar um espelho interno.
BRASILAPI_URL=https://brasilapi.com.br/api

# ---- Frontend (build) ----
VITE_API_URL=/api

# ---- Alerta por e-mail (opcional; sem isto o aviso fica só no painel) ----
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_DE=
# Destinatário padrão. A tela de Configurações tem a última palavra: o que
# estiver preenchido lá sobrescreve isto.
ALERTA_PARA=

# ---- Alerta por WhatsApp (seção 14; opcional) ----
# Meta Cloud API. Sem os três, o envio fica desligado e o aviso segue no
# painel e no e-mail. Nenhum token no código.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Número com DDI, só dígitos (ex.: 5551999999999). A tela sobrescreve.
WHATSAPP_DESTINO=
# Seção 9: nome do modelo aprovado pela Meta (sem ele, só texto livre na janela de 24 h)
WHATSAPP_MODELO=
WHATSAPP_MODELO_IDIOMA=pt_BR

# ---- Push do navegador (Seção 9). Gere uma vez: npx web-push generate-vapid-keys ----
VAPID_CHAVE_PUBLICA=
VAPID_CHAVE_PRIVADA=
# mailto: ou https: de contato, exigido pelos serviços de push
VAPID_ASSUNTO=

# ---- Cobrança (Seção 3 do PLANO_SAAS_CONLICITACAO.md) ----
# manual = o administrador da Studio Mythos ativa o plano pela tela de
# Organizações. Ao escolher o gateway (asaas ou stripe), defina o provedor e o
# segredo do webhook; com 'manual' ou sem segredo, /api/cobranca/webhook fica fechado.
COBRANCA_PROVEDOR=manual
COBRANCA_WEBHOOK_SEGREDO=
