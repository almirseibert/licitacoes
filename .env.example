# ---- API ----
PORTA=4000
NODE_ENV=development

# ---- Banco do painel de licitações (banco PRÓPRIO, separado do CRM) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=licitacoes

# ---- Banco do painel atual, só para reaproveitar o login (leitura da tabela usuarios) ----
AUTH_DB_DATABASE=
JWT_SECRET=
JWT_EXPIRA=8h

# ---- Fila ----
# mysql (padrão) | bullmq
FILA_DRIVER=mysql
FILA_INTERVALO_MS=30000
REDIS_URL=

# ---- Arquivos ----
DIR_DADOS=/dados

# ---- Coleta ----
USER_AGENT=StudioMythosLicitacoes/1.0 (+https://studiomythos.com.br)
HTTP_TIMEOUT_MS=30000
HTTP_CONCORRENCIA=4
HTTP_INTERVALO_DOMINIO_MS=1500

# ---- Leitura assistida por IA (seção 23; opcional) ----
# Sem a chave, a IA fica desligada e o painel funciona inteiro sem ela.
GEMINI_API_KEY=
IA_MODELO=gemini-2.5-flash
IA_TIMEOUT_MS=90000
IA_MAX_TOKENS_SAIDA=4096
IA_ORCAMENTO_RACIOCINIO=512
IA_PONTUACAO_MINIMA=55
# Preço por milhão de tokens, em reais, só para o livro-caixa de `ia_execucoes`.
IA_PRECO_ENTRADA=
IA_PRECO_SAIDA=

# ---- Frontend (build) ----
VITE_API_URL=/api

# ---- Alerta por e-mail (opcional; sem isto o aviso fica só no painel) ----
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_DE=
ALERTA_PARA=
